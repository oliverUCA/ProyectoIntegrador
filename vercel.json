{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/dolibarr-api/:path*",
      "destination": "https://hipermaxi.with11.dolicloud.com/api/index.php/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}